root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 180
# Official Android Kotlin style; drives ktlint rules run by Spotless.
ktlint_code_style = android_studio
# @Composable functions are PascalCase — don't flag them as bad function names.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview
# Wildcard imports are disallowed by the project style.
ij_kotlin_packages_to_use_import_on_demand = unset
# Never auto-collapse a multi-line class or function signature onto one line (and never
# auto-expand a one-liner either) — signature line-wrapping is an author decision, not ktlint's.
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled
# Never strip an existing trailing comma, and never force-add one where absent — leave trailing
# commas exactly as the author wrote them.
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
# Never auto-break a long line (e.g. backticked test names with `= runTest(...) {` on the
# same line) — line-wrapping is an author decision; violations are flagged, not auto-fixed.
ktlint_standard_wrapping = disabled

[*.{yml,yaml,xml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
